# Docker Compose 部署用环境变量
# 复制为 .env 后按需修改，值直接写明文，不要使用 ${VAR} 引用

# 镜像地址（必填），例如 ghcr.io/用户名/fund-next:latest
DOCKER_IMAGE=ghcr.io/你的用户名/仓库名:latest

# Session 密钥（必填，生产环境不少于 16 字符，用于登录态加密）
SESSION_SECRET=your-random-secret-key-at-least-16-chars

# 可选：时区，默认 Asia/Shanghai
# TZ=Asia/Shanghai

# 可选：AI 助手（持仓页浮动问答，支持 OpenAI / DeepSeek 等兼容接口；不配置则不显示）
# AI_API_URL=https://api.openai.com
# AI_API_KEY=sk-xxx
# AI_MODEL=gpt-4o-mini
