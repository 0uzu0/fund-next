{
  "expo": {
    "name": "魔方",
    "slug": "morefund-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "morefund",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "plugins": [
      ["expo-build-properties", {
        "android": {
          "kotlinVersion": "1.9.25",
          "usesCleartextTraffic": true
        }
      }]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morefund.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.morefund.mobile",
      "usesCleartextTraffic": true
    }
  }
}
